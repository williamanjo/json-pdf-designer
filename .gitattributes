# Normalize line endings: LF in the repository, native in the working tree.
# Without this a Windows clone rewrites every file it touches and the diff
# fills with line-ending churn (it did, on the layoutDocument snapshot).
* text=auto eol=lf

# Snapshots and fixtures are compared byte for byte by the test suite.
*.snap text eol=lf
*.json text eol=lf

# Binary — never touched.
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.ico binary
