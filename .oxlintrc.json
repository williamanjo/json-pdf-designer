{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "jsx-a11y"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/anchor-is-valid": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-role": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/heading-has-content": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/label-has-associated-control": "error",
    "jsx-a11y/no-noninteractive-tabindex": "error",
    "jsx-a11y/no-redundant-roles": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/tabindex-no-positive": "error",

    // DESLIGADAS DE PROPÓSITO, e o motivo importa mais que as regras.
    //
    // Estas três disparam em SUPERFÍCIE DE GESTO: a folha do canvas (seleção
    // por caixa, alvo de drop), o puxador de redimensionar coluna, o arrasto
    // de elemento de KPI, o duplo clique que troca a imagem, a célula que
    // entra em edição inline. Nenhuma delas tem equivalente de teclado que
    // faça sentido — "arraste isto 3mm pra direita" não é uma tecla — e
    // todas têm caminho acessível EM OUTRO LUGAR: posição/tamanho, largura de
    // coluna, imagem e conteúdo de célula são todos editáveis pelo painel de
    // propriedades, que é só campo de formulário.
    //
    // Ligar as três produziria 13 avisos que só se calam pondo `role="button"`
    // e um `onKeyDown` vazio em <div> que não são botão — mentir pro leitor
    // de tela pra calar o linter. O que elas apontavam DE VERDADE — selecionar
    // campo, renomear coluna, esconder aba: operações que só existiam no
    // mouse — foi corrigido na 3.3.0, com botão de verdade.
    //
    // `interactive-supports-focus` fica como ERRO logo acima, e é a que
    // guarda essa classe: foi ela que pegou o <span role="button"> sem
    // tabIndex do "x" da barra de abas.
    //
    // `prefer-tag-over-role` quer `<dialog>` em vez de `role="dialog"`. Não
    // dá: `<dialog>` só vira modal via `showModal()`, que joga o elemento na
    // TOP LAYER — ignora z-index, troca o overlay por `::backdrop`, e o
    // `parts.overlay` do <Modal> é API PÚBLICA (um consumidor estiliza esse
    // div). Trocar seria breaking change em troca de nada que o `role` +
    // `aria-modal` + o focus trap de useDialogA11y.ts já não dem.
    //
    // `no-autofocus`: no editor inline o autofocus É o comportamento certo —
    // o usuário acabou de pedir pra editar aquele rótulo, e não mover o foco
    // pro input deixaria a tecla seguinte indo pro lugar errado.
    "jsx-a11y/click-events-have-key-events": "off",
    "jsx-a11y/no-static-element-interactions": "off",
    "jsx-a11y/no-noninteractive-element-interactions": "off",
    "jsx-a11y/prefer-tag-over-role": "off",
    "jsx-a11y/no-autofocus": "off"
  }
}
