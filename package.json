{
  "name": "json-pdf-designer",
  "version": "2.1.1",
  "private": false,
  "description": "Simple visual PDF report editor (drag/resize canvas + JSON data binding) — lean, i18n-ready, and built to be modified.",
  "keywords": [
    "pdf",
    "pdf-generator",
    "pdf-editor",
    "report-designer",
    "report-builder",
    "drag-and-drop",
    "react",
    "pdf-lib",
    "wysiwyg",
    "data-binding",
    "json",
    "template",
    "chart",
    "kpi",
    "dashboard",
    "invoice",
    "canvas-editor",
    "master-detail",
    "i18n",
    "localization",
    "typescript"
  ],
  "license": "MIT",
  "author": "William Anjo (https://github.com/williamanjo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamanjo/json-pdf-designer.git"
  },
  "homepage": "https://williamanjo.github.io/json-pdf-designer/",
  "bugs": {
    "url": "https://github.com/williamanjo/json-pdf-designer/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "import": "./dist/preview.js",
      "require": "./dist/preview.cjs"
    },
    "./style.css": "./dist/style.css",
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup && npm run build:css",
    "build:css": "tailwindcss -i ./src/style.css -o ./dist/style.css --minify",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "pdfjs-dist": "^6.0.0",
    "react-rnd": "^10.4.13",
    "wawoff2": "^2.0.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "react-rnd": {
      "optional": true
    },
    "wawoff2": {
      "optional": true
    }
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "pdf-lib": "^1.17.1",
    "tiny-inflate": "^1.0.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/fontkit": "^2.0.9",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "oxlint": "^1.77.0",
    "pdfjs-dist": "^6.2.108",
    "react-rnd": "^10.4.13",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.3.5",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10",
    "wawoff2": "^2.0.1"
  }
}
